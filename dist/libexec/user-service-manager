#!/bin/sh
set -eu

: "${XDG_RUNTIME_DIR:?}"
: "${SESSIOND_READY_FD:?}"
case "$SESSIOND_READY_FD" in *[!0-9]*|'') exit 64;; esac

scandir="$XDG_RUNTIME_DIR/s6/scandir"
live="$XDG_RUNTIME_DIR/s6/live"
compiled_default=/usr/lib/sessiond/s6-rc/compiled
compiled_user="${XDG_CONFIG_HOME:-$HOME/.config}/sessiond/s6-rc/compiled"
if [ -d "$compiled_user" ]; then compiled=$compiled_user; else compiled=$compiled_default; fi
mkdir -p "$scandir" "$XDG_RUNTIME_DIR/s6"
rm -rf "$live"

s6-svscan "$scandir" &
svscan_pid=$!
count=0
until s6-svscanctl -a "$scandir" 2>/dev/null; do
    kill -0 "$svscan_pid" 2>/dev/null || exit 1
    count=$((count + 1))
    [ "$count" -lt 300 ] || exit 1
    sleep 0.01
done
stopping=0
stop_manager() {
    [ "$stopping" -eq 0 ] || return 0
    stopping=1
    timeout 10 s6-rc -l "$live" -d change default || true
    s6-svscanctl -t "$scandir" || true
}
trap stop_manager TERM INT HUP

s6-rc-init -c "$compiled" -l "$live" "$scandir"
s6-rc -l "$live" -u change default
count=0
while [ ! -S "$XDG_RUNTIME_DIR/bus" ]; do
    kill -0 "$svscan_pid" 2>/dev/null || exit 1
    count=$((count + 1))
    [ "$count" -lt 300 ] || exit 1
    sleep 0.1
done
eval "printf '\001' >&$SESSIOND_READY_FD"
eval "exec $SESSIOND_READY_FD>&-"

while kill -0 "$svscan_pid" 2>/dev/null; do
    wait "$svscan_pid" || status=$?
    [ "${status:-0}" -gt 128 ] || break
    unset status
done
stop_manager
wait "$svscan_pid" 2>/dev/null || true
